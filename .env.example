# Copy this file to .env and fill in your values.
# .env is gitignored — never commit the real key.

# Notion integration token (Settings → Connections → Develop or manage integrations)
NOTION_API_KEY=

# Notion page ID (the long hex string in the page URL)
# Default: ai-resolution-center page
NOTION_PAGE_ID=35a779341fbf80f79c4dc56283f74c09
